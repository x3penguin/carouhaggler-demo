# Copy to .env and fill in. .env is git-ignored. Each model in configs/models.yaml names its key variable (api_key_env).
# Needed for every hosted model (main seller, buyer pool, judge). Runs on local models only don't need it.
OPENROUTER_API_KEY=
# Ollama ignores the key, but the OpenAI SDK requires a non-empty value.
OLLAMA_API_KEY=ollama
# Optional: only used if you add a model entry whose api_key_env points at one of these.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
